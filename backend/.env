# .env.example
APP_NAME=GraphLLM-Backend
DEBUG=true
DATABASE_URL=sqlite:///./graphllm.db

# LLM settings (provider-agnostic)
LLM_PROVIDER=lmstudio
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen2.5-coder-14b
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512
LLM_ENDPOINT_BASE=http://localhost:1234/v1

# RAG defaults
RETRIEVER_TOP_K=5
RETRIEVER_HOPS=2
PROMPT_TEMPLATE_ID=default_rag

# Optional security
API_KEY_ENABLED=false
API_KEY=your-secret-key-here